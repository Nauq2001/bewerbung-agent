# Supabase Postgres connection string (Settings -> Database -> Connection string)
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Anthropic. Leave unset to use an `ant auth login` profile instead.
ANTHROPIC_API_KEY=

# Phases 1-3 run without auth: one user, who is the owner, so personal-tier
# sources are available. Set to false before anyone else can log in.
SINGLE_USER_MODE=true

ENVIRONMENT=development
